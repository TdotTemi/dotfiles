#!/bin/bash
# Re-run when macOS defaults scripts or the defaults data file change.
# macos.sh hash: {{ include "macos.sh" | sha256sum }}
# macos-visual.sh hash: {{ include "macos-visual.sh" | sha256sum }}
# macos-apps.sh hash: {{ include "macos-apps.sh" | sha256sum }}
# macos-trackpad.sh hash: {{ include "macos-trackpad.sh" | sha256sum }}
# trackpad_swipe_fingers: {{ dig "trackpad_swipe_fingers" 4 . }}
# data/macos-defaults.json hash: {{ include "data/macos-defaults.json" | sha256sum }}
set -euo pipefail

# The installer sets this when the user chose to keep their macOS settings.
# Apply them later with: bash {{ .chezmoi.sourceDir }}/macos.sh
if [ "${DOTFILES_SKIP_MACOS_DEFAULTS:-}" = "1" ]; then
  echo "→ Skipping macOS defaults (DOTFILES_SKIP_MACOS_DEFAULTS=1)"
  exit 0
fi

echo "→ Applying macOS defaults..."
bash "{{ .chezmoi.sourceDir }}/macos.sh"

{{ if eq .profile "full" -}}
echo "→ Applying visual preferences..."
DOTFILES_CAPSLOCK_CONTROL="{{ dig "capslock_control" (dig "owner_machine" false .) . }}" bash "{{ .chezmoi.sourceDir }}/macos-visual.sh"
echo "→ Applying app preferences..."
bash "{{ .chezmoi.sourceDir }}/macos-apps.sh"
{{- end }}

# After the visual script, so trackpad_swipe_fingers: 3 wins over its
# three-finger drag default.
DOTFILES_TRACKPAD_SWIPE_FINGERS="{{ dig "trackpad_swipe_fingers" 4 . }}" bash "{{ .chezmoi.sourceDir }}/macos-trackpad.sh"

echo "✓ macOS defaults applied"
